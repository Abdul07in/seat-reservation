### 17. Show counts and seat states reconcile
GET {{baseUrl}}/shows/b5875bdb-77ea-4c4f-88b9-8f1d2fe73626

> {%
  client.test("show inventory reconciles", function () {
    const body = response.body;
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(body.total_seats === 3, "Expected three total seats");
    client.assert(body.counts.available + body.counts.held + body.counts.confirmed === body.total_seats,
      "Expected available + held + confirmed to equal total seats");
    client.assert(body.counts.available === 1 && body.counts.confirmed === 2,
      "Expected A1 and A2 confirmed with A3 available");
  });
%}

{
  "id": "b5875bdb-77ea-4c4f-88b9-8f1d2fe73626",
  "name": "reservation-smoke-fa3716c3-4d6e-42bb-9880-e065fcb8029f",
  "total_seats": 3,
  "counts": {
    "available": 1,
    "held": 0,
    "confirmed": 2
  },
  "seats": [
    {
      "seat": "A1",
      "status": "confirmed"
    },
    {
      "seat": "A2",
      "status": "confirmed"
    },
    {
      "seat": "A3",
      "status": "available"
    }
  ]
}

### 18-19. Deactivate only the temporary test users; the admin account is untouched
DELETE {{baseUrl}}/users/{{reservationBuyerOneId}}
Authorization: Bearer {{reservationAdminToken}}

###
DELETE {{baseUrl}}/users/{{reservationBuyerTwoId}}
Authorization: Bearer {{reservationAdminToken}}
