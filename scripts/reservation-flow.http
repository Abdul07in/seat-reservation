### 11. The second buyer cannot reserve A1
POST {{baseUrl}}/shows/b5875bdb-77ea-4c4f-88b9-8f1d2fe73626/reserve
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzZWF0LXJlc2VydmF0aW9uIiwic3ViIjoiNTQxODE4NDAtMDE1NS00NjljLTg4YWYtM2VhMjVhOTEzZGUxIiwiZXhwIjoxNzkxMDY5MTA4LCJpYXQiOjE3OTEwNjU1MDgsInJvbGVzIjpbIlVTRVIiXX0._DxOHHtJSZZOi1-xMA6CInH-_bCkx0O7rfXJmk6-uu8
Idempotency-Key: smoke-key-a1-other-user
Content-Type: application/json

{"seats": ["A1"]}

> {%
  client.test("already-reserved seat is declined", function () {
    client.assert(response.status === 409, "Expected HTTP 409");
    client.assert(response.body.code === "SEAT_UNAVAILABLE", "Expected seat conflict code");
  });
%}

### 12. Reserve A2 for buyer one (brings buyer one to their limit)
POST {{baseUrl}}/shows/b5875bdb-77ea-4c4f-88b9-8f1d2fe73626/reserve
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzZWF0LXJlc2VydmF0aW9uIiwic3ViIjoiNjdiOTc5NTQtZmIxMS00N2Y3LWFkZTMtOGY5ZDgzNDE1ZGE4IiwiZXhwIjoxNzkxMDY4NzY4LCJpYXQiOjE3OTEwNjUxNjgsInJvbGVzIjpbIlVTRVIiXX0.9py6oJ-mdNnhFDOM7yUgoB3P6HJ7xxjgizr_C9WWYEM
Idempotency-Key: smoke-key-a2
Content-Type: application/json

{"seats": ["A2"]}

> {%
  client.test("A2 reservation succeeds", function () {
    client.assert(response.status === 201, "Expected HTTP 201");
  });
%}

### 13. Buyer one cannot exceed the two-seat limit
POST {{baseUrl}}/shows/b5875bdb-77ea-4c4f-88b9-8f1d2fe73626/reserve
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzZWF0LXJlc2VydmF0aW9uIiwic3ViIjoiNjdiOTc5NTQtZmIxMS00N2Y3LWFkZTMtOGY5ZDgzNDE1ZGE4IiwiZXhwIjoxNzkxMDY4NzY4LCJpYXQiOjE3OTEwNjUxNjgsInJvbGVzIjpbIlVTRVIiXX0.9py6oJ-mdNnhFDOM7yUgoB3P6HJ7xxjgizr_C9WWYEM
Idempotency-Key: smoke-key-a3-over-limit
Content-Type: application/json

{"seats": ["A3"]}

> {%
  client.test("per-user limit is enforced", function () {
    client.assert(response.status === 409, "Expected HTTP 409");
    client.assert(response.body.code === "USER_SEAT_LIMIT_EXCEEDED", "Expected seat-limit conflict code");
  });
%}

### 14. A different buyer cannot cancel buyer one's reservation
POST {{baseUrl}}/reservations/6710fcc9-f08f-4b46-8233-3adc670465f7/cancel
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzZWF0LXJlc2VydmF0aW9uIiwic3ViIjoiNTQxODE4NDAtMDE1NS00NjljLTg4YWYtM2VhMjVhOTEzZGUxIiwiZXhwIjoxNzkxMDY5MTA4LCJpYXQiOjE3OTEwNjU1MDgsInJvbGVzIjpbIlVTRVIiXX0._DxOHHtJSZZOi1-xMA6CInH-_bCkx0O7rfXJmk6-uu8

> {%
  client.test("non-owner cancellation is forbidden", function () {
    client.assert(response.status === 403, "Expected HTTP 403");
  });
%}

### 15. Buyer one cancels A1
POST {{baseUrl}}/reservations/6710fcc9-f08f-4b46-8233-3adc670465f7/cancel
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzZWF0LXJlc2VydmF0aW9uIiwic3ViIjoiNjdiOTc5NTQtZmIxMS00N2Y3LWFkZTMtOGY5ZDgzNDE1ZGE4IiwiZXhwIjoxNzkxMDY4NzY4LCJpYXQiOjE3OTEwNjUxNjgsInJvbGVzIjpbIlVTRVIiXX0.9py6oJ-mdNnhFDOM7yUgoB3P6HJ7xxjgizr_C9WWYEM

> {%
  client.test("owner cancellation succeeds", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.status === "cancelled", "Expected cancelled status");
  });
%}

### 16. Released A1 can be reserved by buyer two
POST {{baseUrl}}/shows/b5875bdb-77ea-4c4f-88b9-8f1d2fe73626/reserve
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzZWF0LXJlc2VydmF0aW9uIiwic3ViIjoiNTQxODE4NDAtMDE1NS00NjljLTg4YWYtM2VhMjVhOTEzZGUxIiwiZXhwIjoxNzkxMDY5MTA4LCJpYXQiOjE3OTEwNjU1MDgsInJvbGVzIjpbIlVTRVIiXX0._DxOHHtJSZZOi1-xMA6CInH-_bCkx0O7rfXJmk6-uu8
